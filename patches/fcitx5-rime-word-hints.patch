diff --git a/src/rimeengine.cpp b/src/rimeengine.cpp
--- a/src/rimeengine.cpp
+++ b/src/rimeengine.cpp
@@ -185,4 +185,18 @@
       factory_([this](InputContext &ic) { return new RimeState(this, ic); }),
       sessionPool_(this, getSharedStatePolicy()) {
+#ifdef FCITX_RIME_BILINGUAL_HINTS
+    try {
+        bilingualDictionary_ =
+            std::make_unique<bilingual::BilingualDictionary>(
+                bilingual::BilingualDictionary::loadTsv(
+                    BILINGUAL_IME_DEFAULT_DICTIONARY));
+        RIME_DEBUG() << "Loaded " << bilingualDictionary_->size()
+                     << " bilingual word hints";
+    } catch (const std::exception &error) {
+        // Word hints are optional. A missing or malformed dictionary must not
+        // prevent Rime from starting.
+        RIME_ERROR() << "Bilingual word hints disabled: " << error.what();
+    }
+#endif
     if constexpr (isAndroid() || isApple()) {
         const auto &sp = StandardPaths::global();
@@ -276,4 +290,16 @@
 }
 
+std::string
+RimeEngine::decorateCandidateComment(std::string_view candidate,
+                                     std::string_view existing) const {
+#ifdef FCITX_RIME_BILINGUAL_HINTS
+    if (bilingualDictionary_) {
+        return bilingual::mergeCandidateComment(
+            existing, bilingualDictionary_->translateCandidate(candidate));
+    }
+#endif
+    return std::string(existing);
+}
+
 RimeEngine::~RimeEngine() {
     factory_.unregister();
