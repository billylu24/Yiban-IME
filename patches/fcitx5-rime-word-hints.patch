+std::string
+RimeEngine::decorateCandidateComment(std::string_view candidate,
+                                     std::string_view existing) const {
+#ifdef FCITX_RIME_BILINGUAL_HINTS
+    if (bilingualDictionary_) {
+        if (const auto *translation = bilingualDictionary_->lookup(candidate)) {
+            return bilingual::mergeCandidateComment(
+                existing, bilingual::formatWordHint(*translation));
+        }
+    }
+#endif
+    return std::string(existing);
+}
